# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do painel, usada no link de login por e-mail (magic link)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Cloud API (app Meta compartilhado por todos os tenants; cada
# tenant guarda seu próprio access token/phone_number_id em channel_connections + Vault)
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Worker de envio: protege /api/cron/dispatch. Ao configurar esta env var no
# projeto Vercel, o próprio Vercel Cron passa a enviar este valor sozinho no
# header Authorization — não é preciso configurar nada mais lá.
CRON_SECRET=
